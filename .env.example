# --- Application environment ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Host port published by Docker Compose (outside the container).
APP_PORT=3000
# Set to 1 when the app is behind Caddy/Nginx so req.ip and rate limits see
# the real client address (X-Forwarded-For).
TRUST_PROXY=0

# --- Data directories (absolute or relative to the app root) ---
DATA_DIR=/app/data
APP_DB_PATH=/app/data/app.db
LINKS_DB_PATH=/app/data/links.db
UPLOADS_DIR=/app/data/uploads

# --- Security ---
# Required: generate a strong secret with `openssl rand -hex 32` and set it here.
SESSION_SECRET=change-me-to-a-strong-32-byte-hex-secret
# Public origin used in verification/reset email links and canonical URLs.
APP_BASE_URL=https://filmerz.ir
# Secure cookies are forced on in production. Set to 0 only for a plain-HTTP
# local test of a production build.
COOKIE_SECURE=1

# --- Site ---
PER_PAGE=24

# --- Accounts ---
# Require a verified email address before login. When SMTP is not configured,
# registration is disabled (the UI explains why) instead of silently failing.
REQUIRE_EMAIL_VERIFICATION=1
AUTH_SESSION_TTL_MS=2592000000
EMAIL_VERIFICATION_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=1800000
OAUTH_STATE_TTL_MS=600000
# scrypt cost (N must be a power of two). Raise only with free RAM headroom.
SCRYPT_N=65536
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_MAXMEM=167772160
# Login throttling (per IP / per account+IP window).
LOGIN_IP_WINDOW_MS=900000
LOGIN_IP_MAX=40
LOGIN_ACCOUNT_WINDOW_MS=900000
LOGIN_ACCOUNT_MAX=10

# --- Transactional email (verification + password reset) ---
# Without these, verification mail cannot be sent and registration stays off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=

# --- Google Sign-In (optional) ---
# Authorised redirect URI: https://filmerz.ir/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://filmerz.ir/auth/google/callback
# Optional: HTTP(S) proxy used only for Google's OAuth API calls, e.g.
# http://user:pass@10.0.0.5:3128. Leave empty when the server can reach
# oauth2.googleapis.com directly.
GOOGLE_PROXY_URL=
# Optional. The app already retries on www.googleapis.com/oauth2/v4/token when
# oauth2.googleapis.com is unreachable, so this is only needed to force a
# specific endpoint.
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# --- Source site (external crawling credentials) ---
# Required to resolve fresh play links at runtime.
SOURCE_BASE_URL=https://flzios.com
SOURCE_LOGIN_PATH=/login
SOURCE_PHONE=your-source-phone
SOURCE_PASSWORD=your-source-password
SOURCE_PHONE_FIELD=phone
SOURCE_PASSWORD_FIELD=password
RESOLVE_TTL_MS=180000
SOURCE_TIMEOUT_MS=8000

# --- Host allowlists (regex strings matched against hostnames) ---
ALLOWED_DL_HOSTS=(^|\.)tdmm2\.ir|(^|\.)abrtech\.top|(^|\.)mehracdn\.com
POSTER_HOSTS=(^|\.)findmylinkes\.ir|(^|\.)intocdn\.top
