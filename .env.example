# --- Application environment ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=0

# --- Data directories (absolute or relative to the app root) ---
DATA_DIR=/app/data
APP_DB_PATH=/app/data/app.db
LINKS_DB_PATH=/app/data/links.db
UPLOADS_DIR=/app/data/uploads

# --- Security ---
# Required: generate a strong secret with `openssl rand -hex 32` and set it here.
SESSION_SECRET=change-me-to-a-strong-32-byte-hex-secret

# --- Site ---
PER_PAGE=24

# --- Source site (external crawling credentials) ---
# Required to resolve fresh play links at runtime.
SOURCE_BASE_URL=https://flzios.com
SOURCE_LOGIN_PATH=/login
SOURCE_PHONE=your-source-phone
SOURCE_PASSWORD=your-source-password
SOURCE_PHONE_FIELD=phone
SOURCE_PASSWORD_FIELD=password
RESOLVE_TTL_MS=180000
SOURCE_TIMEOUT_MS=8000

# --- Host allowlists (regex strings matched against hostnames) ---
ALLOWED_DL_HOSTS=(^|\.)tdmm2\.ir|(^|\.)abrtech\.top|(^|\.)mehracdn\.com
POSTER_HOSTS=(^|\.)findmylinkes\.ir|(^|\.)intocdn\.top
