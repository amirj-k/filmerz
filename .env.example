# Copy this file to .env, then fill in the blanks. Never commit .env.
# Compose reads .env automatically for ${...} substitution.

# --- Compose / HTTP ---------------------------------------------------------
# Host port published by Compose.
APP_PORT=3000
# Port the Node process listens on inside the container.
PORT=3000
NODE_ENV=production
HOST=0.0.0.0
# REQUIRED by docker-compose.yml. Generate a fresh value and paste it here:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs out existing admin sessions.
SESSION_SECRET=
# Set to 1 only when a trusted reverse proxy terminates TLS in front of the app.
TRUST_PROXY=0

# --- Persistent storage (container paths) -----------------------------------
DATA_DIR=/app/data
APP_DB_PATH=/app/data/app.db
UPLOADS_DIR=/app/data/uploads
# Used by scripts/backup.js and scripts/create-admin.js; keep in sync with APP_DB_PATH.
APP_DB=/app/data/app.db
# Crawler DB used only by scripts/import.js (not by the web server).
LINKS_DB_PATH=/app/links.db

# --- Application tuning (optional) ------------------------------------------
PER_PAGE=24
RESOLVE_TTL_MS=180000
SOURCE_TIMEOUT_MS=8000

# --- External source integration (optional) ---------------------------------
# Needed for resolving fresh play/download links. Do not commit real credentials.
SOURCE_BASE_URL=https://flzios.com
SOURCE_LOGIN_PATH=/login
SOURCE_PHONE=
SOURCE_PASSWORD=
SOURCE_PHONE_FIELD=phone
SOURCE_PASSWORD_FIELD=password
# Host allowlist regexes. Leave empty to use the application defaults.
ALLOWED_DL_HOSTS=
POSTER_HOSTS=
