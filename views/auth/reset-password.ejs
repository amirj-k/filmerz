<%- include('../partials/header', { noindex: true }) %>

<div class="auth-shell">
  <section class="auth-card" aria-labelledby="reset-title">
    <h1 id="reset-title">رمز عبور جدید</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="form-error" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/reset-password" data-auth-form data-validate="reset" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="field">
        <label for="reset-password">رمز عبور جدید</label>
        <div class="pw-wrap">
          <input id="reset-password" name="password" type="password" dir="ltr" required
                 minlength="<%= minPasswordLength %>" maxlength="<%= maxPasswordLength %>"
                 autocomplete="new-password">
          <button type="button" class="pw-toggle" data-pw-toggle
                  aria-label="نمایش رمز عبور" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="2.6"/></svg>
          </button>
        </div>
        <span class="field-hint">دست‌کم <%= minPasswordLength %> کاراکتر</span>
      </div>

      <div class="field">
        <label for="reset-confirm">تکرار رمز عبور</label>
        <div class="pw-wrap">
          <input id="reset-confirm" name="confirm_password" type="password" dir="ltr" required
                 minlength="<%= minPasswordLength %>" maxlength="<%= maxPasswordLength %>"
                 autocomplete="new-password">
          <button type="button" class="pw-toggle" data-pw-toggle
                  aria-label="نمایش رمز عبور" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="2.6"/></svg>
          </button>
        </div>
      </div>

      <p class="form-msg" data-form-msg role="alert" hidden></p>
      <button class="btn auth-submit" type="submit" data-submit>
        <span data-submit-label>ذخیره</span>
      </button>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
