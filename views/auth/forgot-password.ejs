<%- include('../partials/header', { noindex: true }) %>

<div class="auth-shell">
  <section class="auth-card" aria-labelledby="forgot-title">
    <h1 id="forgot-title">بازیابی رمز</h1>
    <p class="auth-lead">پیوند تعیین رمز جدید برایتان ایمیل می‌شود.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="form-error" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/forgot-password" data-auth-form data-validate="forgot" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="forgot-email">ایمیل</label>
        <input id="forgot-email" name="email" type="email" inputmode="email" dir="ltr" required
               maxlength="254" autocomplete="email"
               value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>">
      </div>
      <p class="form-msg" data-form-msg role="alert" hidden></p>
      <button class="btn auth-submit" type="submit" data-submit>
        <span data-submit-label>ارسال پیوند</span>
      </button>
    </form>

    <p class="auth-switch"><a href="/login">بازگشت به ورود</a></p>
  </section>
</div>

<%- include('../partials/footer') %>
