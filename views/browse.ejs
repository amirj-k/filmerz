<%- include('partials/header') %>

<%
  const activeLabels = [];
  if (names.genre) activeLabels.push(names.genre);
  if (names.country) activeLabels.push(names.country);
  if (names.person) activeLabels.push(names.person);
  if (names.year) activeLabels.push('سال ' + names.year);
  const hasFilter = Boolean(filters.genre || filters.year || filters.country || filters.person);
%>

<header class="page-head">
  <div>
    <span class="page-eyebrow">آرشیو فیلم‌ها<% if (activeLabels.length) { %> · <%= activeLabels.join(' · ') %><% } %></span>
    <h1 class="page-title"><%= seoMetadata.heading %></h1>
    <p class="page-sub">در این آرشیو، فیلم‌ها همراه با داستان، ژانر، سال ساخت، کشور و نسخه‌های رایگان پخش و دانلود فهرست شده‌اند.</p>
  </div>
  <span class="page-count"><%= result.total %> فیلم</span>
</header>

<section class="section">
  <div class="filter-panel">
    <% if (genres.length) { %>
      <div class="filter-row">
        <span class="filter-label">ژانر</span>
        <div class="filter-scroll" role="group" aria-label="فیلتر ژانر">
          <a class="chip <%= !filters.genre ? 'active' : '' %>" href="/movies">همه</a>
          <% genres.slice(0, 16).forEach(g => { %>
            <a class="chip <%= filters.genre === g.slug ? 'active' : '' %>" href="/genre/<%= g.slug %>"><%= g.name %> <span class="c"><%= g.c %></span></a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (years.length) { %>
      <div class="filter-row">
        <span class="filter-label">سال</span>
        <div class="filter-scroll" role="group" aria-label="فیلتر سال">
          <a class="chip <%= !filters.year ? 'active' : '' %>" href="/movies">همه</a>
          <% years.slice(0, 14).forEach(y => { %>
            <a class="chip <%= String(filters.year) === String(y.year) ? 'active' : '' %>" href="/year/<%= y.year %>"><%= y.year %> <span class="c"><%= y.c %></span></a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="filter-row">
      <span class="filter-label">ترتیب</span>
      <div class="filter-scroll" role="group" aria-label="ترتیب نمایش">
        <a class="chip <%= filters.sort === 'newest' ? 'active' : '' %>" href="<%= buildQuery({ sort: 'newest', page: '' }) %>">جدیدترین</a>
        <a class="chip <%= filters.sort === 'year' ? 'active' : '' %>" href="<%= buildQuery({ sort: 'year', page: '' }) %>">جدیدترین سال</a>
        <a class="chip <%= filters.sort === 'year_asc' ? 'active' : '' %>" href="<%= buildQuery({ sort: 'year_asc', page: '' }) %>">قدیمی‌ترین سال</a>
        <a class="chip <%= filters.sort === 'title' ? 'active' : '' %>" href="<%= buildQuery({ sort: 'title', page: '' }) %>">الفبا</a>
      </div>
    </div>

    <% if (hasFilter) { %>
      <div class="filter-row">
        <span class="filter-label">فیلتر فعال</span>
        <div class="filter-scroll">
          <span class="tag on"><%= activeLabels.join(' · ') %></span>
          <a class="chip" href="<%= basePath %>">پاک کردن فیلترها ✕</a>
        </div>
      </div>
    <% } %>
  </div>

  <% if (result.items.length) { %>
    <div class="grid">
      <% result.items.forEach(m => { %><%- include('partials/card', { m }) %><% }) %>
    </div>
    <%- include('partials/pagination', { buildHref: p => buildQuery({ page: p === 1 ? '' : p }) }) %>
  <% } else { %>
    <div class="center-page"><p class="muted">فیلمی با این فیلترها پیدا نشد.</p></div>
  <% } %>
</section>

<%- include('partials/footer') %>
