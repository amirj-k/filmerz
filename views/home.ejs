<%- include('partials/header') %>

<header class="page-head home-head">
  <div>
    <span class="page-eyebrow">فیلمرز · آرشیو فیلم و سریال</span>
    <h1 class="page-title"><%= seoMetadata.heading %></h1>
    <p class="page-sub">آرشیوی از فیلم‌ها و سریال‌ها همراه با اطلاعات بازیگران و عوامل، ژانر، سال ساخت و نسخه‌های موجود برای پخش و دانلود.</p>
  </div>
  <span class="page-count"><%= data.newest.length ? data.newest.length + ' عنوان تازه' : '' %></span>
</header>

<a class="top-teaser" href="/top250">
  <span class="top-teaser-copy">
    <span class="top-kicker">★ فهرست ویژه</span>
    <h2>Top 250 <span class="imdb">IMDB</span></h2>
  </span>
  <span class="btn">مشاهده Top 250 ←</span>
</a>

<% if (data.featured.length) { %>
  <section class="hero" aria-labelledby="featured-title">
    <% const f = data.featured[0]; %>
    <% if (f.poster_valid && f.poster_url) { %>
      <img class="hero-bg" src="<%= posterSrc(f) %>" alt="" aria-hidden="true">
    <% } %>
    <div class="hero-fade"></div>
    <div class="hero-body">
      <h2 id="featured-title" class="series-title" dir="auto"><%= f.title_en || f.title_fa %><%= f.year ? ' (' + f.year + ')' : '' %></h2>
      <% if (f.title_fa && f.title_en) { %><p><%= f.title_fa %></p><% } %>
      <div class="actions">
        <a class="btn" href="<%= movieHref(f) %>">مشاهده و تماشا</a>
        <a class="btn ghost" href="/movies">آرشیو فیلم‌ها</a>
      </div>
    </div>
  </section>
<% } %>

<% if (data.featured.length > 1) { %>
  <section class="section">
    <div class="section-head"><h2>فیلم‌های ویژه</h2></div>
    <div class="grid">
      <% data.featured.slice(1).forEach(m => { %><%- include('partials/card', { m }) %><% }) %>
    </div>
  </section>
<% } %>

<section class="section">
  <div class="section-head"><h2>جدیدترین فیلم‌ها</h2><a class="more" href="/movies">همه فیلم‌ها ←</a></div>
  <div class="grid">
    <% data.newest.forEach(m => { %><%- include('partials/card', { m }) %><% }) %>
  </div>
</section>

<% if (data.yearChips.length) { %>
  <section class="section">
    <div class="section-head"><h2>فیلم‌ها بر اساس سال</h2><a class="more" href="/movies">همه سال‌ها ←</a></div>
    <div class="chips">
      <% data.yearChips.forEach(y => { %>
        <a class="chip" href="/year/<%= y.year %>"><%= y.year %> <span class="c"><%= y.c %></span></a>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (data.series && data.series.length) { %>
  <section class="section">
    <div class="section-head"><h2>سریال‌های جدید</h2><a class="more" href="/series">همه سریال‌ها ←</a></div>
    <div class="grid">
      <% data.series.forEach(s => { %><%- include('partials/series-card', { s }) %><% }) %>
    </div>
  </section>
<% } %>

<% data.genreRows.forEach(({ genre, movies }) => { %>
  <section class="section">
    <div class="section-head"><h2>فیلم‌های ژانر <%= genre.name %></h2><a class="more" href="/genre/<%= genre.slug %>">بیشتر ←</a></div>
    <div class="grid">
      <% movies.forEach(m => { %><%- include('partials/card', { m }) %><% }) %>
    </div>
  </section>
<% }) %>

<% if (!data.newest.length && !data.featured.length) { %>
  <div class="center-page">
    <p class="muted">هنوز فیلمی وارد نشده است. ابتدا اسکریپت import را اجرا کنید:</p>
    <p><code>node scripts/import.js</code></p>
  </div>
<% } %>

<%- include('partials/footer') %>
