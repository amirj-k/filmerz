<%- include('../partials/header') %>
<%- include('_nav') %>

<header class="admin-page-head">
  <div>
    <h1>داشبورد مدیریت</h1>
    <p class="muted">همه‌چیز از یک‌جا: فیلم‌ها، سریال‌ها و لینک‌های پخش و دانلود.</p>
  </div>
  <div class="admin-head-actions">
    <a class="btn" href="/admin/movies/new">＋ افزودن فیلم</a>
    <a class="btn secondary" href="/admin/series/new">＋ افزودن سریال</a>
  </div>
</header>

<div class="stat-grid">
  <div class="stat"><div class="n"><%= stats.movies %></div><div class="l">فیلم</div></div>
  <div class="stat"><div class="n"><%= stats.published %></div><div class="l">فیلم منتشرشده</div></div>
  <div class="stat"><div class="n"><%= stats.links %></div><div class="l">لینک فیلم</div></div>
  <div class="stat"><div class="n"><%= stats.withPlayUrl %></div><div class="l">لینک با play_url</div></div>
  <div class="stat"><div class="n"><%= stats.series %></div><div class="l">سریال</div></div>
  <div class="stat"><div class="n"><%= stats.episodes %></div><div class="l">قسمت</div></div>
  <div class="stat"><div class="n"><%= stats.episodeLinks %></div><div class="l">لینک قسمت</div></div>
  <div class="stat"><div class="n"><%= stats.genres %></div><div class="l">ژانر</div></div>
</div>

<div class="admin-quick-grid">
  <a class="admin-quick-card" href="/admin/movies/new">
    <span class="admin-quick-ico" aria-hidden="true">🎬</span>
    <b>افزودن فیلم</b>
    <span>اطلاعات فیلم، پوستر و لینک‌های دانلود را یک‌جا ثبت کنید.</span>
  </a>
  <a class="admin-quick-card" href="/admin/series/new">
    <span class="admin-quick-ico" aria-hidden="true">📺</span>
    <b>افزودن سریال</b>
    <span>سریال را با فصل، قسمت و لینک‌های هر قسمت بسازید.</span>
  </a>
  <a class="admin-quick-card" href="/admin/movies">
    <span class="admin-quick-ico" aria-hidden="true">🔎</span>
    <b>مدیریت فیلم‌ها</b>
    <span>جستجو، ویرایش، انتشار و مدیریت لینک‌های فیلم‌ها.</span>
  </a>
  <a class="admin-quick-card" href="/admin/series">
    <span class="admin-quick-ico" aria-hidden="true">🗂️</span>
    <b>مدیریت سریال‌ها</b>
    <span>جستجو، ویرایش و مدیریت قسمت‌ها و لینک‌های سریال.</span>
  </a>
</div>

<div class="admin-two-col">
  <section class="admin-panel">
    <div class="admin-panel-head">
      <h2>آخرین فیلم‌ها</h2>
      <a class="admin-panel-link" href="/admin/movies">همه فیلم‌ها ←</a>
    </div>
    <% if (recentMovies.length) { %>
      <ul class="admin-list">
        <% recentMovies.forEach(m => { %>
          <li class="admin-list-item">
            <div class="admin-list-main">
              <a href="/admin/movies/<%= m.id %>/edit"><%= m.title_en || m.title_fa || ('#' + m.id) %></a>
              <span class="muted">
                <%= m.title_fa && m.title_en ? m.title_fa + ' · ' : '' %><%= m.year || 'بدون سال' %> · <%= m.link_count %> لینک
              </span>
            </div>
            <span class="tag <%= m.published ? 'on' : '' %>"><%= m.published ? 'منتشرشده' : 'پیش‌نویس' %></span>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="admin-empty">هنوز فیلمی ثبت نشده است. با «افزودن فیلم» شروع کنید.</p>
    <% } %>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-head">
      <h2>آخرین سریال‌ها</h2>
      <a class="admin-panel-link" href="/admin/series">همه سریال‌ها ←</a>
    </div>
    <% if (recentSeries.length) { %>
      <ul class="admin-list">
        <% recentSeries.forEach(s => { %>
          <li class="admin-list-item">
            <div class="admin-list-main">
              <a href="/admin/series/<%= s.id %>/edit"><%= s.title_en || s.title_fa || ('#' + s.id) %></a>
              <span class="muted">
                <%= s.title_fa && s.title_en ? s.title_fa + ' · ' : '' %><%= s.year || 'بدون سال' %> ·
                <%= s.season_count %> فصل / <%= s.episode_count %> قسمت / <%= s.link_count %> لینک
              </span>
            </div>
            <span class="tag <%= s.published ? 'on' : '' %>"><%= s.published ? 'منتشرشده' : 'پیش‌نویس' %></span>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="admin-empty">هنوز سریالی ثبت نشده است. با «افزودن سریال» شروع کنید.</p>
    <% } %>
  </section>
</div>

<%- include('../partials/footer', { adminScript: false }) %>
