<%- include('../partials/header', { noindex: true }) %>

<header class="page-head">
  <div>
    <span class="page-eyebrow">حساب من</span>
    <h1 class="page-title">پروفایل</h1>
  </div>
  <span class="page-count"><%= profile.emailVerified ? 'ایمیل تأیید شده' : 'ایمیل تأیید نشده' %></span>
</header>

<div class="account-shell">
  <aside class="account-sidebar">
    <%- include('_nav') %>
  </aside>

  <section class="account-main">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="form-success" role="status"><%= message %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="form-error" role="alert"><%= error %></div>
    <% } %>

    <div class="profile-hero">
      <span class="profile-avatar" aria-hidden="true">
        <% if (profile.avatarUrl) { %>
          <img src="<%= profile.avatarUrl %>" alt="" referrerpolicy="no-referrer" width="72" height="72">
        <% } else { %>
          <%= String(profile.displayName || '?').slice(0, 1) %>
        <% } %>
      </span>
      <div class="profile-id">
        <h2 dir="auto"><%= profile.displayName %></h2>
        <p class="muted" dir="ltr"><%= profile.email %></p>
        <p class="profile-badges">
          <span class="tag <%= profile.emailVerified ? 'on' : '' %>"><%= profile.emailVerified ? 'ایمیل تأیید شده' : 'در انتظار تأیید ایمیل' %></span>
          <% if (profile.hasPassword) { %><span class="tag">ورود با رمز عبور</span><% } %>
          <% if (identities && identities.some((i) => i.provider === 'google')) { %><span class="tag on">متصل به گوگل</span><% } %>
        </p>
      </div>
    </div>

    <dl class="account-facts">
      <div><dt>تاریخ عضویت</dt><dd><%= formatDate(profile.createdAt) %></dd></div>
      <div><dt>آخرین ورود</dt><dd><%= formatDate(profile.lastLoginAt) || '—' %></dd></div>
      <div><dt>علاقه‌مندی‌ها</dt><dd><%= counts.favorites %></dd></div>
      <div><dt>لیست تماشا</dt><dd><%= counts.watchlist %></dd></div>
    </dl>

    <form class="form-card account-form" method="post" action="/account/profile" data-auth-form data-validate="profile" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h3>ویرایش نام نمایشی</h3>
      <div class="field">
        <label for="profile-name">نام نمایشی</label>
        <input id="profile-name" name="display_name" type="text" required minlength="2" maxlength="60"
               autocomplete="nickname" value="<%= profile.displayName %>">
      </div>
      <div class="field">
        <label for="profile-email">ایمیل</label>
        <input id="profile-email" type="email" dir="ltr" value="<%= profile.email %>" disabled>
        <span class="field-hint">تغییر ایمیل در این نسخه فعال نیست؛ برای این کار با پشتیبانی تماس بگیرید.</span>
      </div>
      <p class="form-msg" data-form-msg role="alert" hidden></p>
      <button class="btn" type="submit" data-submit><span data-submit-label>ذخیره تغییرات</span></button>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
