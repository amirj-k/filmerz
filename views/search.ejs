<%- include('partials/header') %>

<header class="page-head">
  <div>
    <span class="page-eyebrow">جست‌وجو</span>
    <h1 class="page-title"><%= seoMetadata.heading %></h1>
    <p class="page-sub">نتایج از میان فیلم‌ها و سریال‌های موجود در فیلمرز نمایش داده می‌شوند.</p>
  </div>
  <span class="page-count"><%= (result.total || 0) + (seriesResult.total || 0) %> نتیجه</span>
</header>

<section class="section">
  <% if (seriesResult.items.length) { %>
    <section class="section">
      <div class="section-head"><h2>سریال‌ها</h2><span class="more muted"><%= seriesResult.total %> سریال</span></div>
      <div class="grid">
        <% seriesResult.items.forEach(s => { %><%- include('partials/series-card', { s }) %><% }) %>
      </div>
    </section>
  <% } %>

  <% if (result.items.length) { %>
    <section class="section">
      <div class="section-head">
        <h2>فیلم‌ها</h2>
        <span class="more muted"><%= result.total %> فیلم</span>
      </div>
      <div class="grid">
        <% result.items.forEach(m => { %><%- include('partials/card', { m }) %><% }) %>
      </div>
      <%- include('partials/pagination', { buildHref: p => buildQuery({ page: p === 1 ? '' : p }) }) %>
    </section>
  <% } else if (q && !seriesResult.items.length) { %>
    <div class="center-page">
      <p class="muted">برای «<%= q %>» چیزی پیدا نشد. عبارتی کوتاه‌تر امتحان کنید.</p>
    </div>
  <% } else if (!q) { %>
    <div class="center-page"><p class="muted">برای جستجو، عبارتی بنویسید.</p></div>
  <% } %>
</section>

<%- include('partials/footer') %>
