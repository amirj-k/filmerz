<%- include('partials/header') %>

<%
  const epCount = episodes.length;
  const epIndex = episode ? episodes.findIndex(e => e.id === episode.id) : -1;
%>

<nav class="breadcrumb" aria-label="مسیر">
  <a href="/">خانه</a>
  <span class="sep">/</span>
  <a href="/series">سریال‌ها</a>
  <span class="sep">/</span>
  <span aria-current="page"><%= s.title_en || s.title_fa %></span>
</nav>

<header class="series-hero">
  <% if (s.poster_valid && s.poster_url) { %>
    <img class="series-ambient" src="<%= posterSrc(s) %>" alt="" aria-hidden="true" loading="lazy" decoding="async">
  <% } %>
  <div class="series-poster">
    <% if (s.poster_valid && s.poster_url) { %>
      <img src="<%= posterSrc(s) %>" alt="پوستر سریال <%= s.title_en || s.title_fa %><%= s.year ? ' (' + s.year + ')' : '' %>" width="300" height="450" fetchpriority="high" decoding="async">
    <% } else { %>
      <div class="no-poster" aria-hidden="true">📺</div>
    <% } %>
  </div>

  <div class="series-hero-body">
    <div class="series-eyebrow">
      <span class="pill"><%= s.season_count %> فصل</span>
      <% if (s.year) { %><span class="pill"><%= s.year %></span><% } %>
      <% if (s.country_name) { %><a class="pill" href="/series?country=<%= s.country_slug %>"><%= s.country_name %></a><% } %>
      <% if (s.age_rating) { %><span class="pill"><%= s.age_rating %>+</span><% } %>
      <% if (s.status_text) { %><span class="pill"><%= s.status_text %></span><% } %>
    </div>

    <h1 class="series-title" dir="auto"><%= seoMetadata.heading %></h1>
    <% if (s.title_fa && s.title_en) { %><p class="series-title-sub" dir="auto"><%= s.title_fa %></p><% } %>

    <div class="series-stats" aria-label="آمار سریال">
      <div class="stat-tile"><span class="n"><%= s.season_count %></span><span class="l">فصل</span></div>
      <div class="stat-tile"><span class="n"><%= s.episode_count %></span><span class="l">قسمت</span></div>
    </div>

    <% if (s.genres.length) { %>
      <div class="chips" aria-label="ژانرها">
        <% s.genres.forEach(g => { %><a class="chip" href="/series?genre=<%= g.slug %>"><%= g.name %></a><% }) %>
      </div>
    <% } %>

    <div class="series-actions">
      <% if (seasons.length) { %>
        <a class="btn" href="#episodes">
          <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5z"/></svg>
          انتخاب قسمت
        </a>
      <% } %>
      <button class="btn secondary wishlist-btn<%= inWishlist ? ' active' : '' %>" type="button"
              data-wishlist-toggle data-type="series" data-id="<%= s.id %>"
              aria-pressed="<%= inWishlist ? 'true' : 'false' %>">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.7-5.2 2.7 1-5.9L3.5 9.7l5.9-.9L12 3.5z"/></svg>
        <span data-wishlist-label><%= inWishlist ? 'در نشان‌ها' : 'افزودن به نشان‌ها' %></span>
      </button>
      <% if (s.title_en) { %><a class="btn secondary" href="/search?q=<%= encodeURIComponent(s.title_en) %>">جستجوی این سریال</a><% } %>
    </div>
  </div>
</header>

<% if (s.plot) { %>
  <section class="section" id="story">
    <div class="section-head"><h2>داستان سریال</h2></div>
    <p><%= s.plot %></p>
  </section>
<% } %>

<% if (s.directors.length || s.actors.length) { %>
  <section class="section" id="cast">
    <div class="section-head"><h2>بازیگران و عوامل</h2></div>
    <div class="series-people">
      <% if (s.directors.length) { %>
        <div><b>کارگردان:</b> <% s.directors.forEach((d, i) => { %><a href="/movies?person=<%= d.id %>"><%= d.name %></a><%= i < s.directors.length - 1 ? '، ' : '' %><% }) %></div>
      <% } %>
      <% if (s.actors.length) { %>
        <div><b>ستارگان:</b> <% s.actors.forEach((a, i) => { %><a href="/movies?person=<%= a.id %>"><%= a.name %></a><%= i < s.actors.length - 1 ? '، ' : '' %><% }) %></div>
      <% } %>
    </div>
  </section>
<% } %>

<section class="section" id="specs">
  <div class="section-head"><h2>مشخصات سریال</h2></div>
  <dl class="spec-list">
    <% if (s.title_en) { %><dt>نام اصلی</dt><dd dir="auto"><%= s.title_en %></dd><% } %>
    <% if (s.title_fa) { %><dt>نام فارسی</dt><dd dir="auto"><%= s.title_fa %></dd><% } %>
    <% if (s.year) { %><dt>سال ساخت</dt><dd><a href="/series?year=<%= s.year %>"><%= s.year %></a></dd><% } %>
    <% if (s.country_name) { %><dt>کشور</dt><dd><a href="/series?country=<%= s.country_slug %>"><%= s.country_name %></a></dd><% } %>
    <% if (s.genres.length) { %>
      <dt>ژانر</dt>
      <dd><% s.genres.forEach((g, i) => { %><a href="/series?genre=<%= g.slug %>"><%= g.name %></a><%= i < s.genres.length - 1 ? '، ' : '' %><% }) %></dd>
    <% } %>
    <dt>تعداد فصل</dt><dd><%= s.season_count %></dd>
    <dt>تعداد قسمت</dt><dd><%= s.episode_count %></dd>
    <% if (s.status_text) { %><dt>وضعیت</dt><dd><%= s.status_text %></dd><% } %>
    <% if (s.age_rating) { %><dt>رده سنی</dt><dd><%= s.age_rating %>+</dd><% } %>
  </dl>
</section>

<% if (seasons.length) { %>
  <section class="section" id="episodes">
    <script type="application/json" id="series-episode-data" nonce="<%= nonce %>"><%- episodeJson %></script>

    <%
      const epLabel = (n) => (n === 0 ? 'ویژه' : String(n));
    %>

    <div class="section-head">
      <div class="head-copy">
        <h2>فصل‌ها و قسمت‌ها</h2>
        <span class="muted">فصل را انتخاب کنید و سپس قسمت مورد نظر را بزنید.</span>
      </div>
      <span class="more muted"><%= epCount %> قسمت در فصل <%= seasonNo %></span>
    </div>

    <nav class="season-scroller" aria-label="انتخاب فصل">
      <% seasons.forEach(se => { %>
        <a class="season-pill <%= se.season_no === seasonNo ? 'active' : '' %>"
           href="<%= seasonHref(se.season_no) %>"
           data-season="<%= se.season_no %>"
           <%= se.season_no === seasonNo ? 'aria-current="page"' : '' %>>
          فصل <%= se.season_no %> <span class="c"><%= se.episode_count %></span>
        </a>
      <% }) %>
    </nav>

    <div class="episode-workbench">
      <div data-episode-grid-host>
        <% if (episodes.length) { %>
          <div class="episode-grid" role="list" aria-label="قسمت‌های فصل <%= seasonNo %>">
            <% episodes.forEach((ep, i) => { %>
              <a class="episode-btn <%= episode && ep.id === episode.id ? 'active' : '' %>"
                 role="listitem"
                 href="<%= episodeHref(seasonNo, ep.episode_no) %>"
                 aria-label="فصل <%= seasonNo %> <%= ep.episode_no === 0 ? 'ویژه' : 'قسمت ' + ep.episode_no %>"
                 <%= episode && ep.id === episode.id ? 'aria-current="page"' : '' %>
                 data-episode-index="<%= i %>"
                 data-episode-no="<%= ep.episode_no %>">
                <span class="n"><%= epLabel(ep.episode_no) %></span>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">برای این فصل هنوز قسمتی ثبت نشده است.</div>
        <% } %>
      </div>

      <% if (episode) { %>
        <aside class="episode-panel" id="episode-panel" aria-labelledby="episode-panel-title">
          <div class="episode-panel-head">
            <span class="episode-kicker">فصل <%= episode.season_no %> · <%= episode.episode_no === 0 ? 'ویژه' : 'قسمت ' + episode.episode_no %></span>
            <h3 class="episode-panel-title" id="episode-panel-title">پخش و دانلود</h3>
            <% if (epIndex >= 0) { %>
              <p class="episode-panel-sub"><%= epIndex + 1 %> از <%= epCount %></p>
            <% } %>
          </div>
          <div class="episode-panel-body">
            <% if (links.length) { %>
              <%- include('partials/downloads', { downloads, resolveType: 'episode', resolveId: episode.id }) %>
            <% } else { %>
              <p class="episode-empty">برای این قسمت هنوز گزینه‌ای ثبت نشده است.</p>
            <% } %>
          </div>
        </aside>
      <% } %>
    </div>

    <%# Pre-rendered panels: the client only clones, so switching seasons or
        episodes never asks the server again. %>
    <div class="episode-templates" hidden>
      <% seasons.forEach(se => { %>
        <% se.episodes.forEach((ep, i) => { %>
          <template data-episode-template="<%= ep.id %>">
            <aside class="episode-panel" id="episode-panel" aria-labelledby="episode-panel-title">
              <div class="episode-panel-head">
                <span class="episode-kicker">فصل <%= se.season_no %> · <%= ep.episode_no === 0 ? 'ویژه' : 'قسمت ' + ep.episode_no %></span>
                <h3 class="episode-panel-title" id="episode-panel-title">پخش و دانلود</h3>
                <p class="episode-panel-sub"><%= i + 1 %> از <%= se.episodes.length %></p>
              </div>
              <div class="episode-panel-body">
                <% if (ep.links.length) { %>
                  <%- include('partials/downloads', { downloads: episodeDownloads.get(ep.id), resolveType: 'episode', resolveId: ep.id }) %>
                <% } else { %>
                  <p class="episode-empty">برای این قسمت هنوز گزینه‌ای ثبت نشده است.</p>
                <% } %>
              </div>
            </aside>
          </template>
        <% }) %>
      <% }) %>
    </div>
  </section>
<% } else { %>
  <div class="empty-state">برای این سریال هنوز فصلی ثبت نشده است.</div>
<% } %>

<% if (related.length) { %>
  <section class="section">
    <div class="section-head"><h2>سریال‌های مشابه</h2></div>
    <div class="grid">
      <% related.forEach(x => { %><%- include('partials/series-card', { s: x }) %><% }) %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
