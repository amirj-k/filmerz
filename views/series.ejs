<%- include('partials/header') %>

<section class="section">
  <div class="section-head"><h2>مجموعه‌ها و سریال‌ها</h2><span class="more muted"><%= result.total %> مجموعه</span></div>

  <% if (result.items.length) { %>
    <div class="grid">
      <% result.items.forEach(s => { %>
        <a class="card" href="/series/<%= encodeURIComponent(s.key) %>">
          <% if (s.poster_valid && s.poster_url) { %>
            <img class="poster" loading="lazy" src="<%= posterSrc(s) %>" alt="<%= s.title_en || s.title_fa %>">
          <% } else { %>
            <div class="no-poster">🎬</div>
          <% } %>
          <span class="badge"><%= s.episodes %> قسمت</span>
          <div class="meta">
            <div class="t"><%= s.title_en || s.title_fa || 'بدون عنوان' %></div>
            <div class="sub">
              <% if (s.title_fa && s.title_en) { %><span><%= s.title_fa %></span><% } %>
              <% if (s.year_min && s.year_min !== s.year) { %><span><%= s.year_min %>–<%= s.year %></span><% } else if (s.year) { %><span><%= s.year %></span><% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
    <%- include('partials/pagination', { buildHref: p => buildHref(p) }) %>
  <% } else { %>
    <div class="center-page"><p class="muted">هنوز مجموعه‌ای ثبت نشده است.</p></div>
  <% } %>
</section>

<%- include('partials/footer') %>
