<a class="card" href="<%= movieHref(m) %>">
  <% if (locals.showEpisode && m.episode_no) { %>
    <span class="badge ep">قسمت <%= m.episode_no %></span>
  <% } else if (m.featured) { %><span class="badge feat">ویژه</span><% } else if (m.quality_res) { %><span class="badge"><%= m.quality_res %></span><% } %>
  <% if (m.poster_valid && m.poster_url) { %>
    <img class="poster" loading="lazy" src="<%= posterSrc(m) %>" alt="<%= m.title_en || m.title_fa %>">
  <% } else { %>
    <div class="no-poster">🎬</div>
  <% } %>
  <div class="meta">
    <div class="t"><%= m.title_en || m.title_fa || 'بدون عنوان' %></div>
    <div class="sub">
      <% if (m.title_fa && m.title_en) { %><span><%= m.title_fa %></span><% } %>
      <% if (m.year) { %><span><%= m.year %></span><% } %>
    </div>
  </div>
</a>
