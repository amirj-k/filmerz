<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    const seo = typeof seoMetadata !== 'undefined' && seoMetadata ? seoMetadata : null;
    const forceNoindex = typeof noindex !== 'undefined' && noindex;
    const pageTitle = seo && seo.title ? seo.title : title;
    const description = seo && seo.description ? seo.description : '';
    // The metadata builder is the single source of truth for robots and
    // canonical. Indexability must never silently override it (that used to
    // make /search?q=… indexable while the SEO engine said noindex).
    const robotsContent = forceNoindex ? 'noindex, follow' : (seo && seo.robots ? seo.robots : 'noindex, follow');
    const canonicalHref = seo && seo.canonicalUrl ? seo.canonicalUrl : '';
    const ogImage = seo && seo.og && seo.og.image ? seo.og.image : '';
    const ogUrl = seo && seo.og && seo.og.url ? seo.og.url : canonicalHref;
    const ogType = seo && seo.og && seo.og.type ? seo.og.type : 'website';
  %>
  <meta name="theme-color" content="#0b0b0f">
  <meta name="color-scheme" content="dark light">
  <title><%= pageTitle %></title>
  <meta name="robots" content="<%= robotsContent %>">
  <% if (canonicalHref && !forceNoindex && seo.pageType !== '404' && seo.pageType !== '500') { %>
  <link rel="canonical" href="<%= canonicalHref %>">
  <% } %>
  <% if (description) { %>
  <meta name="description" content="<%= description %>">
  <% } %>
  <% if (seo) { %>
  <meta property="og:site_name" content="فیلمرز">
  <meta property="og:locale" content="fa_IR">
  <meta property="og:type" content="<%= ogType %>">
  <meta property="og:title" content="<%= seo.og.title || pageTitle %>">
  <meta property="og:description" content="<%= seo.og.description || description %>">
  <% if (ogUrl) { %><meta property="og:url" content="<%= ogUrl %>"><% } %>
  <% if (ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:alt" content="<%= seo.heading || pageTitle %>">
  <% } %>
  <meta name="twitter:card" content="<%= seo.twitter.card %>">
  <meta name="twitter:title" content="<%= seo.twitter.title %>">
  <meta name="twitter:description" content="<%= seo.twitter.description %>">
  <% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>
  <% if (seo.siteStructuredData) { %>
  <script type="application/ld+json" nonce="<%= nonce %>"><%- String(seo.siteStructuredData).replace(/</g, '\\u003c') %></script>
  <% } %>
  <% if (seo.structuredData) { %>
  <script type="application/ld+json" nonce="<%= nonce %>"><%- String(seo.structuredData).replace(/</g, '\\u003c') %></script>
  <% } %>
  <% if (seo.breadcrumbs && seo.breadcrumbs.length > 1) { %>
  <script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: seo.breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      item: crumb.url
    }))
  }).replace(/</g, '\\u003c') %></script>
  <% } %>
  <% } %>
  <link rel="stylesheet" href="/css/main.css?v=20261109">
  <link rel="icon" href="/favicon.ico?v=20261030" sizes="any">
  <link rel="icon" href="/favicon.svg?v=20261030" type="image/svg+xml">
  <link rel="icon" href="/favicon-32x32.png?v=20261030" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-16x16.png?v=20261030" type="image/png" sizes="16x16">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261030" sizes="180x180">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="wishlist-token" content="<%= wishlistToken %>">
  <meta name="apple-mobile-web-app-title" content="Filmerz">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <link rel="manifest" href="/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script nonce="<%= nonce %>">
    (function () {
      try {
        var t = localStorage.getItem('fmz-theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">پرش به محتوا</a>
  <header class="site-header">
    <div class="container bar">
      <a class="logo" href="/">فیلمرز<span class="dot">.</span></a>
      <button class="icon-btn nav-toggle" type="button" data-nav-toggle
              aria-label="باز کردن منو" aria-expanded="false" aria-controls="main-nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
        </svg>
      </button>
      <nav class="main-nav" id="main-nav" aria-label="ناوبری اصلی">
        <a href="/movies" class="<%= currentPath.startsWith('/movies') ? 'active' : '' %>"<%= currentPath.startsWith('/movies') ? ' aria-current="page"' : '' %>>فیلم‌ها</a>
        <a href="/series" class="<%= currentPath.startsWith('/series') ? 'active' : '' %>"<%= currentPath.startsWith('/series') ? ' aria-current="page"' : '' %>>سریال‌ها</a>
        <a href="/top250" class="nav-top<%= currentPath.startsWith('/top250') ? ' active' : '' %>"<%= currentPath.startsWith('/top250') ? ' aria-current="page"' : '' %>>Top 250</a>
        <a href="/genres" class="<%= currentPath.startsWith('/genres') ? 'active' : '' %>"<%= currentPath.startsWith('/genres') ? ' aria-current="page"' : '' %>>ژانرها</a>
      </nav>
      <form class="searchbox" action="/search" role="search" autocomplete="off">
        <span class="s-ico">🔍</span>
        <input type="search" name="q" placeholder="جستجوی فیلم، سریال، بازیگر…" value="<%= typeof q !== 'undefined' ? q : '' %>" aria-label="جستجو">
        <div class="suggest" role="listbox"></div>
      </form>
      <div class="header-tools">
        <a class="icon-btn wishlist-icon" href="/wishlist" title="نشان‌ها" aria-label="نشان‌ها">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.7-5.2 2.7 1-5.9L3.5 9.7l5.9-.9L12 3.5z"/></svg>
          <span class="wishlist-count<%= wishlistCount ? '' : ' hidden' %>" data-wishlist-count><%= wishlistCount %></span>
        </a>
        <button class="icon-btn" data-theme-toggle title="تغییر پوسته" aria-label="تغییر پوسته">◐</button>
        <% if (typeof admin !== 'undefined' && admin) { %>
          <a class="icon-btn" href="/admin" title="پنل مدیریت" aria-label="پنل مدیریت">⚙</a>
        <% } %>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <details class="user-menu">
            <summary class="avatar-btn" aria-label="منوی حساب کاربری">
              <% if (currentUser.avatarUrl) { %>
                <img src="<%= currentUser.avatarUrl %>" alt="" referrerpolicy="no-referrer" width="32" height="32">
              <% } else { %>
                <span class="avatar-initial" aria-hidden="true"><%= String(currentUser.displayName || '?').slice(0, 1) %></span>
              <% } %>
            </summary>
            <div class="user-menu-panel">
              <div class="user-menu-head">
                <b dir="auto"><%= currentUser.displayName %></b>
                <span dir="ltr"><%= currentUser.email %></span>
              </div>
              <a href="/account/profile">حساب من</a>
              <a href="/account/favorites">علاقه‌مندی‌ها</a>
              <a href="/account/watchlist">لیست تماشا</a>
              <a href="/account/history">تاریخچه تماشا</a>
              <a href="/account/settings">تنظیمات حساب</a>
              <form method="post" action="/logout">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="menu-danger" type="submit">خروج از حساب</button>
              </form>
            </div>
          </details>
        <% } else { %>
          <a class="btn small secondary auth-link" href="/login?next=<%= encodeURIComponent(currentPath || '/') %>">ورود</a>
          <a class="btn small auth-link" href="/register">ثبت‌نام</a>
        <% } %>
      </div>
    </div>
  </header>
  <main class="container fade-in" id="main">
